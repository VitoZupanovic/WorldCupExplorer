<Window
    x:Class="WPF.PlayerDetailsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Player Details"
    Width="420"
    Height="430"
    Opacity="0"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation
                        Storyboard.TargetProperty="Opacity"
                        From="0"
                        To="1"
                        Duration="0:0:0.3" />

                    <DoubleAnimation
                        Storyboard.TargetName="RootGrid"
                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                        From="25"
                        To="0"
                        Duration="0:0:0.3" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
    <Grid
        Name="RootGrid"
        Margin="20"
        RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TranslateTransform Y="25" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Margin="0,0,0,15"
            FontSize="22"
            FontWeight="Bold"
            Text="Player details" />

        <Image
            Name="imgPlayer"
            Grid.Row="1"
            Width="100"
            Height="100"
            Margin="0,0,0,20"
            HorizontalAlignment="Center"
            Stretch="UniformToFill" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,0,0,8"
                FontWeight="Bold"
                Text="Name:" />
            <TextBlock
                Name="txtName"
                Grid.Row="0"
                Grid.Column="1"
                Margin="0,0,0,8" />

            <TextBlock
                Grid.Row="1"
                Grid.Column="0"
                Margin="0,0,0,8"
                FontWeight="Bold"
                Text="Shirt number:" />
            <TextBlock
                Name="txtShirtNumber"
                Grid.Row="1"
                Grid.Column="1"
                Margin="0,0,0,8" />

            <TextBlock
                Grid.Row="2"
                Grid.Column="0"
                Margin="0,0,0,8"
                FontWeight="Bold"
                Text="Position:" />
            <TextBlock
                Name="txtPosition"
                Grid.Row="2"
                Grid.Column="1"
                Margin="0,0,0,8" />

            <TextBlock
                Grid.Row="3"
                Grid.Column="0"
                Margin="0,0,0,8"
                FontWeight="Bold"
                Text="Captain:" />
            <TextBlock
                Name="txtCaptain"
                Grid.Row="3"
                Grid.Column="1"
                Margin="0,0,0,8" />

            <TextBlock
                Grid.Row="4"
                Grid.Column="0"
                Margin="0,0,0,8"
                FontWeight="Bold"
                Text="Goals in match:" />
            <TextBlock
                Name="txtGoals"
                Grid.Row="4"
                Grid.Column="1"
                Margin="0,0,0,8" />

            <TextBlock
                Grid.Row="5"
                Grid.Column="0"
                Margin="0,0,0,8"
                FontWeight="Bold"
                Text="Yellow cards:" />
            <TextBlock
                Name="txtYellowCards"
                Grid.Row="5"
                Grid.Column="1"
                Margin="0,0,0,8" />
        </Grid>

        <Button
            Name="btnClose"
            Grid.Row="3"
            Width="90"
            Height="30"
            HorizontalAlignment="Right"
            Click="btnClose_Click"
            Content="Close" />
    </Grid>
</Window>
