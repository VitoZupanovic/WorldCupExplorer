<Window
    x:Class="WPF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="World Cup Stats"
    Width="1280"
    Height="720"
    MinWidth="1100"
    MinHeight="700"
    Closing="Window_Closing"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock
                VerticalAlignment="Center"
                DockPanel.Dock="Left"
                FontSize="24"
                FontWeight="Bold"
                Text="World Cup Stats" />

            <TextBlock
                Name="txtLoading"
                Margin="15,0,15,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                FontWeight="Bold"
                Foreground="Black"
                Text="Loading..."
                Visibility="Collapsed" />

            <Button
                Name="btnSettings"
                Width="100"
                Height="30"
                HorizontalAlignment="Right"
                Click="btnSettings_Click"
                Content="Settings"
                DockPanel.Dock="Right" />
        </DockPanel>

        <TextBlock
            Name="txtCurrentSettings"
            Grid.Row="1"
            Margin="0,0,0,20"
            FontSize="14"
            Text="Current settings:" />

        <Grid Grid.Row="2" Margin="0,0,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,0,10,10"
                VerticalAlignment="Center"
                Text="Favorite team:" />

            <ComboBox
                Name="cmbFavoriteTeam"
                Grid.Row="0"
                Grid.Column="1"
                Height="30"
                Margin="0,0,0,10"
                SelectionChanged="cmbFavoriteTeam_SelectionChanged" />

            <Button
                Name="btnFavoriteTeamDetails"
                Grid.Row="0"
                Grid.Column="2"
                Height="30"
                Margin="10,0,0,10"
                Click="btnFavoriteTeamDetails_Click"
                Content="Details" />

            <TextBlock
                Grid.Row="0"
                Grid.Column="4"
                Margin="0,0,10,10"
                VerticalAlignment="Center"
                Text="Opponent team:" />

            <ComboBox
                Name="cmbOpponentTeam"
                Grid.Row="0"
                Grid.Column="5"
                Height="30"
                Margin="0,0,0,10"
                SelectionChanged="cmbOpponentTeam_SelectionChanged" />

            <Button
                Name="btnOpponentTeamDetails"
                Grid.Row="0"
                Grid.Column="6"
                Height="30"
                Margin="10,0,0,10"
                Click="btnOpponentTeamDetails_Click"
                Content="Details" />

            <TextBlock
                Grid.Row="1"
                Grid.Column="0"
                Margin="0,10,10,0"
                VerticalAlignment="Center"
                FontWeight="Bold"
                Text="Result:" />

            <TextBlock
                Name="txtMatchResult"
                Grid.Row="1"
                Grid.Column="1"
                Grid.ColumnSpan="6"
                Margin="0,10,0,0"
                VerticalAlignment="Center"
                FontSize="18"
                FontWeight="Bold"
                Text="Select teams to show result" />
        </Grid>

        <Border
            Grid.Row="3"
            Padding="10"
            BorderBrush="DarkGreen"
            BorderThickness="2"
            CornerRadius="8">
            <Grid MinHeight="400">
                <Grid.Background>
                    <ImageBrush ImageSource="Images/football-field.jpg" Stretch="Fill" />
                </Grid.Background>

                <Canvas
                    Name="canvasField"
                    Background="Transparent"
                    SizeChanged="canvasField_SizeChanged" />
            </Grid>
        </Border>
    </Grid>
</Window>
